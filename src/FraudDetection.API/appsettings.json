{
  "ConnectionStrings": {
    "FraudDb": "Host=localhost;Port=5432;Database=fraud_detection;Username=fraud;Password=fraud"
  },
  "LoyaltyApi": {
    "BaseUrl": "http://localhost:5000",
    "WebhookSecret": "CHANGE_ME_SHARED_HMAC_SECRET_MIN_32_CHARS",
    "PollingIntervalSeconds": 60,
    "PollingInitialLookbackMinutes": 30
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fraud-detection-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
